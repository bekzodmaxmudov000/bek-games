# Frontend (Vite). Only needed when the multiplayer server is on another address.
# In development leave it empty: Vite forwards /api to http://localhost:8787.
# VITE_API_URL=https://bek-games-server.example.com

# Server (Node). Set these on the machine that runs `npm run server`:
# PORT=8787
# ALLOWED_ORIGINS=https://your-site.example   # comma separated, required in production
# BEK_SERVER_SECRET=<long random string>      # signs player tokens, keep it private (never in the frontend)
# DATA_DIR=/var/data/bek-games                # where rooms and players are saved
# TRUST_PROXY=1                               # set when running behind a reverse proxy
PORT=8787
BEK_SERVER_SECRET=bek-games-dev-secret-2026-random-928374
DATA_DIR=./data